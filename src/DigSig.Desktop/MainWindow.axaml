<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:DigSig.Desktop"
        x:Class="DigSig.Desktop.MainWindow"
        x:DataType="app:MainViewModel"
        Title="DigSig"
        Width="780" Height="680" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <DockPanel Margin="16">

    <!-- Header: server status -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="DigSig" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="{Binding AppVersion}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
        </StackPanel>
        <TextBlock Classes="muted" Text="Signs excise declarations from the CDEPS portal with your token." />
      </StackPanel>
      <Border Grid.Column="1" Classes="card" Padding="10,6" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                   Fill="#2EA043" IsVisible="{Binding IsServerRunning}" />
          <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                   Fill="#DA3633" IsVisible="{Binding !IsServerRunning}" />
          <TextBlock Text="{Binding ServerStatus}" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding ServerStatus}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Settings -->
    <Expander DockPanel.Dock="Bottom" Header="Settings" Margin="0,12,0,0" HorizontalAlignment="Stretch">
      <StackPanel Spacing="10">
        <CheckBox IsChecked="{Binding UseWindowsStore}" IsVisible="{Binding IsWindows}"
                  Content="Use certificates from the Windows certificate store (SafeNet token via its Windows driver)" />
        <CheckBox IsChecked="{Binding UsePkcs11}"
                  Content="Read the token directly through its PKCS#11 library (works on Windows, macOS and Linux)" />
        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding UsePkcs11}">
          <TextBox Text="{Binding Pkcs11Library}" Watermark="Path to eTPKCS11.dll / libeTPkcs11.so / libeTPkcs11.dylib" />
          <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowsePkcs11" />
        </Grid>
        <Separator />
        <Grid ColumnDefinitions="Auto,90,*" RowDefinitions="Auto,Auto">
          <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBox Grid.Column="1" Text="{Binding Port}" />
          <TextBlock Grid.Row="1" Text="Allowed sites" VerticalAlignment="Center" Margin="0,8,10,0" />
          <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Text="{Binding AllowedOriginsText}"
                   Watermark="Empty = any website may ask for signatures (like the old app). e.g. https://portal.example.mk" />
        </Grid>
        <Button Content="Apply and restart server" Click="OnApplyServer" />
        <Separator />
        <TextBlock Text="HTTPS certificate for https://localhost" FontWeight="SemiBold" />
        <TextBlock Classes="muted" Text="{Binding HttpsCertificateInfo}" TextWrapping="Wrap" />
        <WrapPanel>
          <Button Content="Trust in Windows" Click="OnTrustHttps" IsVisible="{Binding IsWindows}" Margin="0,0,8,8"
                  ToolTip.Tip="Add the certificate to your trusted certificates so the browser accepts https://localhost without warnings" />
          <Button Content="Import from the original DigSig .jar…" Click="OnImportHttps" Margin="0,0,8,8"
                  ToolTip.Tip="Reuse the certificate of digsig-signer-x.y.z.jar if your browser already trusts it" />
          <Button Content="Open https://localhost in the browser" Click="OnOpenInBrowser" Margin="0,0,8,8" />
        </WrapPanel>
        <Separator />
        <CheckBox IsChecked="{Binding CloseToTray}" Content="Closing the window keeps the signer running in the tray" />
        <CheckBox IsChecked="{Binding StartMinimized}" Content="Start minimized to the tray" />
      </StackPanel>
    </Expander>

    <Grid RowDefinitions="Auto,Auto,3*,Auto,2*">

      <!-- Certificates -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="section" Text="Signing certificate" />
          <TextBlock Classes="muted" Margin="0,-4,0,8" Text="Click a certificate to sign with it. The choice is remembered." />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button Content="Refresh" Click="OnRefresh" ToolTip.Tip="Look for tokens again (e.g. after plugging one in)" />
          <Button Content="Add .pfx…" Click="OnAddPfx" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Classes="card warning" Margin="0,0,0,8" IsVisible="{Binding HasWarning}">
        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" />
      </Border>

      <Border Grid.Row="2" Classes="card" Padding="4">
      <Panel>
        <ListBox ItemsSource="{Binding Certificates}" SelectionMode="Single" Name="CertificateList"
                 SelectionChanged="OnCertificateSelected" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="app:CertificateItem">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4" Opacity="{Binding IsUsable, Converter={x:Static app:Converters.UsableOpacity}}">
                <RadioButton IsChecked="{Binding IsActive}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,0,4,0" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" Text="{Binding Details}" />
                  <TextBlock Classes="muted" Text="{Binding Source}" />
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                        Background="{Binding IsUsable, Converter={x:Static app:Converters.StatusBrush}}">
                  <TextBlock Text="{Binding Availability}" FontSize="12" Foreground="White" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock IsVisible="{Binding HasNoCertificates}" Classes="muted" TextWrapping="Wrap" Margin="12"
                   Text="No signing certificates found. Plug in your token and press Refresh, or check the settings below." />
      </Panel>
      </Border>

      <!-- Actions + activity -->
      <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,6">
        <TextBlock Classes="section" Text="Activity" VerticalAlignment="Bottom" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Test signature" Click="OnTestSignature" IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="Sign a small sample document to check the token and PIN" />
          <Button Content="Lock" Click="OnLock" ToolTip.Tip="Close the token session; the PIN is asked again next time" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="4" Classes="card" Padding="4">
        <ListBox ItemsSource="{Binding Activity}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="app:ActivityItem">
              <Grid ColumnDefinitions="60,18,*,Auto">
                <TextBlock Classes="muted" Text="{Binding Time}" VerticalAlignment="Top" Margin="0,1,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontWeight="Bold"
                           Foreground="{Binding Success, Converter={x:Static app:Converters.FailureBrush}}" />
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" Text="{Binding Message}" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="{Binding Origin}" IsVisible="{Binding Origin, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <TextBlock Grid.Column="3" Classes="muted" Text="{Binding Duration}" Margin="8,1,0,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>
  </DockPanel>
</Window>
